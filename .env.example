# tv-wake-launcher configuration. Copy to .env and edit. Everything device-specific lives here.
# Format: KEY=value (quote values with spaces). Full-line comments only.

# ---------------------------------------------------------------- helper (Ubuntu box running the agent)
# Address the TV uses to reach the agent. Give the helper a DHCP reservation.
HELPER_HOST=192.168.1.155
HELPER_PORT=8787
# Address the agent listens on. Default: HELPER_HOST (LAN only, not VPN/docker interfaces).
# HELPER_BIND=0.0.0.0
# For scripts/deploy.sh: ssh alias (or user@host) of the helper, and the folder there.
HELPER_SSH=l590
HELPER_DIR=tv-wake-launcher
# systemd units as your user without sudo ("user") or system-wide ("system", needs sudo).
SYSTEMD_MODE=user

# ---------------------------------------------------------------- security
# Shared secret between the TV app and the agent (>= 32 chars). Generate: scripts/gen-secret.sh --write
# Changing it requires rebuilding/reinstalling the TV app and restarting the agent.
SHARED_SECRET=

# ---------------------------------------------------------------- gaming PC
# Give the PC a DHCP reservation; it must be on the same network segment as the helper
# (Wake-on-LAN broadcasts do not cross routers).
PC_IP=192.168.1.132
PC_MAC=2c:f0:5d:e6:1c:ee
# Broadcast address of the LAN (x.x.x.255 for a /24).
WOL_BROADCAST=192.168.1.255
# UDP ports for the magic packet, how many packets per burst, and how often to re-send
# while waiting for the PC to boot (0 = never).
WOL_PORTS=9,7
WOL_REPEAT=3
WOL_RESEND_S=20

# ---------------------------------------------------------------- streaming
# moonlight (Moonlight on the TV + Sunshine/Apollo on the PC) or steamlink.
STREAM_BACKEND=moonlight
# Port that answers when the streaming server is up. Defaults: moonlight 47989, steamlink 27036.
# STREAM_PORT=47989
# webOS app to launch at the end. Defaults: com.limelight.webos / com.valvesoftware.steamlink
# STREAM_APP_ID=com.limelight.webos
# STREAM_APP_TITLE=Moonlight
# Optional JSON launch parameters for that app, in SINGLE quotes. Moonlight TV: connect to a
# host and start an app directly (host uuid from http://PC_IP:47989/serverinfo, app number
# from Moonlight's app info dialog):
# STREAM_APP_PARAMS='{"host_uuid":"XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX","host_app_id":123456}'

# ---------------------------------------------------------------- timings (seconds)
# After WoL: wait this long without checking, then poll every POLL_INTERVAL_S.
QUIET_PERIOD_S=30
POLL_INTERVAL_S=4
# Max time from WoL until the PC answers (includes the quiet period).
BOOT_TIMEOUT_S=150
# Max time from "PC answers" until the streaming server port is open.
STREAM_TIMEOUT_S=90

# ---------------------------------------------------------------- mock mode (test the TV app without the PC)
# MOCK_PC=1: no real PC is contacted. The fake PC "boots" MOCK_BOOT_S after WoL and starts its
# server MOCK_STREAM_S later, and switches itself off again after MOCK_AUTO_OFF_S (0 = never).
# MOCK_FAIL=boot|stream makes that step fail so you can see the error screens.
MOCK_PC=0
MOCK_BOOT_S=20
MOCK_STREAM_S=10
MOCK_AUTO_OFF_S=120
MOCK_FAIL=none
MOCK_INITIALLY_ON=0

# ---------------------------------------------------------------- TV
# Name of the TV in the webOS CLI (ares-setup-device -l) and its IP (DHCP reservation!).
TV_DEVICE_NAME=lgtv
TV_IP=192.168.1.111
# Wired MAC of the TV, for scripts/tv-on.sh (switch the TV on over the network).
TV_MAC=d0:cd:bf:ed:48:84
# Developer Mode SSH (fixed by LG): user "prisoner" on port 9922.
TV_SSH_PORT=9922
TV_SSH_USER=prisoner
# Passphrase-free copy of the TV key, created by scripts/setup-tv-key.sh.
TV_SSH_KEY=~/.ssh/tvwake_tv

# ---------------------------------------------------------------- Developer Mode renewal
# LG endpoints ({token} is replaced). Kept here in case LG changes them.
DEVMODE_RENEW_URL=https://developer.lge.com/secure/ResetDevModeSession.dev?sessionToken={token}
DEVMODE_CHECK_URL=https://developer.lge.com/secure/CheckDevModeSession.dev?sessionToken={token}
# How often the timer runs (minutes); how often to do the cloud reset (hours).
DEVMODE_TICK_MIN=5
DEVMODE_RENEW_INTERVAL_H=24
# "Extend" on the TV itself when it is switched on, at most this often (hours).
DEVMODE_EXTEND_INTERVAL_H=168
# Ask LG for the remaining time this often (hours).
DEVMODE_CHECK_INTERVAL_H=6
# Where state (and the cached token) is stored on the helper.
STATE_DIR=~/.local/state/tvwake

# ---------------------------------------------------------------- TV app identity
# Change APP_ID/APP_TITLE to install a second copy under another name.
APP_ID=com.home.tvwake
APP_TITLE="PC Game"
APP_VERSION=1.0.0
# How often the TV polls the helper (ms); close the app after launching the stream app (1/0).
TV_POLL_MS=1500
TV_CLOSE_AFTER_LAUNCH=1

LOG_LEVEL=INFO
